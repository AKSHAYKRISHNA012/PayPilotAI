# =================================================================
# PAYPILOT AI — COMMERCIAL SAAS ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env and configure for your target environment.
# Never commit real API secrets or private keys to version control.

# Application Environment
APP_NAME="PayPilot AI Enterprise SaaS"
APP_VERSION="2.0.0"
APP_ENV=development                # Options: development, staging, production
DEBUG=true                         # Set to false in staging/production

# Database Configuration
# Default: Local SQLite WAL-mode file. For Postgres: postgresql://user:password@host:5432/paypilot
DATABASE_URL=sqlite:///./paypilot.db

# Cryptographic Keys & JWT Security
# Generate secure 64-character tokens: openssl rand -hex 32
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_SECRET=replace-with-a-cryptographically-secure-jwt-secret-token
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 Hours
RATE_LIMIT_PER_MINUTE=120

# Payment Gateway (Razorpay India)
# Retrieve test & live credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# AI Providers (Optional LLM enrichment; deterministic auditor runs offline without keys)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Multi-Tenancy Sandbox Defaults
DEFAULT_COMPANY_ID=comp_ind_001
DEFAULT_COMPANY_NAME="BharatTech Innovations Pvt. Ltd."

# Allowed CORS Origins (comma-separated or list in config.py)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://yourdomain.com"]
